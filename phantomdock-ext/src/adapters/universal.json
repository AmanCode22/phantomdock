{
  "$schema": "phantomdock-adapter-v2",
  "id": "universal-fallback",
  "name": "Universal Fallback",
  "hostMatch": [
    "*"
  ],
  "enabled": true,
  "selectors": {
    "chatContainer": "body",
    "messageList": "main, [class*='chat'], [class*='message'], [role='log'], body",
    "userMessage": "[data-message-author-role='user'], [data-role='user'], [class*='user-message']",
    "assistantMessage": "[data-message-author-role='assistant'], [data-role='assistant'], [class*='assistant-message'], [class*='bot-message']",
    "messageMarkdownBody": "[class*='markdown'], [class*='prose'], [class*='message-content'], article",
    "streamingIndicator": "button[aria-label*='Stop'], [data-testid='stop-button'], [class*='stop-button'], [class*='generating']",
    "inputBox": "textarea, [contenteditable='true']",
    "sendButton": "button[type='submit'], button[aria-label*='Send'], button[class*='send']",
    "pillMountAnchor": "form, [class*='input'], body",
    "rateLimitBanner": "[class*='rate-limit'], [class*='usage-limit'], [class*='quota-exceeded']",
    "challengeBanner": "iframe[src*='turnstile'], iframe[src*='arkoselabs'], iframe[src*='hcaptcha'], [class*='captcha']"
  },
  "fileUpload": {
    "supported": true,
    "preferInlineOverUpload": false,
    "cascadeOrder": [
      "input",
      "paste",
      "drop"
    ],
    "fileInputSelector": "input[type='file']",
    "dropZoneSelector": "form, [class*='input-container'], [class*='chat-input']",
    "attachmentChipSelector": "[class*='file-card'], [class*='attachment'], [class*='upload-item']",
    "uploadingSpinnerSelector": "[class*='uploading'], [class*='loading'], [role='progressbar']",
    "uploadTimeoutMs": 10000,
    "fallbackToInlineOnFailure": true
  },
  "inlineSkills": {
    "chunkSizeChars": 6000,
    "autoSendAllParts": false
  },
  "inputBehavior": {
    "inputType": "auto",
    "submitMethod": "click",
    "submitDelayRangeMs": [
      400,
      1400
    ],
    "interTurnDelayRangeMs": [
      3000,
      8000
    ],
    "sendEnableTimeoutMs": 2500,
    "randomizeClickCoords": true,
    "clearBeforeInsert": true
  },
  "loopProtection": {
    "requireVisibleTab": true,
    "cooldownSeconds": 60,
    "backoffMultiplier": 2,
    "maxCooldownSeconds": 900,
    "maxConsecutiveAutoTurns": 15,
    "maxAutomatedTurnsPerHour": 60
  }
}
