{
  "$schema": "phantomdock-adapter-v2",
  "id": "deepseek-chat",
  "name": "DeepSeek Chat",
  "hostMatch": [
    "chat.deepseek.com"
  ],
  "enabled": true,
  "selectors": {
    "chatContainer": ".ds-virtual-list, main, body",
    "messageList": ".ds-virtual-list-items, .ds-virtual-list-visible-items, .ds-virtual-list",
    "userMessage": ".ds-message:has(.ds-collapsible-text), .ds-message:not(:has(.ds-assistant-message-main-content)):not(:has(.ds-markdown))",
    "assistantMessage": ".ds-message:has(.ds-assistant-message-main-content), .ds-message:has(.ds-markdown)",
    "messageMarkdownBody": ".ds-assistant-message-main-content, .ds-markdown, .ds-markdown-paragraph",
    "streamingIndicator": "[class*='stop-button'], button[aria-label*='Stop'], [role='button'][aria-label*='Stop'], [class*='generating']",
    "inputBox": "textarea[placeholder*='DeepSeek'], textarea, [contenteditable='true']",
    "sendButton": "[role='button'].ds-button--primary, .ds-button--circle, button[type='submit'], button[aria-label*='Send']",
    "pillMountAnchor": ".ds-virtual-list--printable, [class*='aaff8b8f'], form",
    "rateLimitBanner": "[class*='server-busy'], [class*='rate-limit'], .ds-notification-container [role='alert']",
    "challengeBanner": "iframe[src*='turnstile'], iframe[src*='arkoselabs'], iframe[src*='hcaptcha'], [class*='captcha']"
  },
  "fileUpload": {
    "supported": true,
    "preferInlineOverUpload": false,
    "cascadeOrder": [
      "input",
      "paste",
      "drop"
    ],
    "fileInputSelector": "input[type='file']",
    "dropZoneSelector": "[class*='aaff8b8f'], [class*='_871cbca'], .ds-virtual-list--printable, form",
    "attachmentChipSelector": "[class*='file-card'], [class*='attachment'], [class*='upload-item']",
    "uploadingSpinnerSelector": "[class*='uploading'], [class*='loading'], [role='progressbar']",
    "uploadTimeoutMs": 10000,
    "fallbackToInlineOnFailure": true
  },
  "inlineSkills": {
    "chunkSizeChars": 6000,
    "autoSendAllParts": false
  },
  "inputBehavior": {
    "inputType": "textarea",
    "submitMethod": "click",
    "submitDelayRangeMs": [
      400,
      1400
    ],
    "interTurnDelayRangeMs": [
      3000,
      8000
    ],
    "sendEnableTimeoutMs": 2500,
    "randomizeClickCoords": true,
    "clearBeforeInsert": true
  },
  "loopProtection": {
    "requireVisibleTab": true,
    "cooldownSeconds": 60,
    "backoffMultiplier": 2,
    "maxCooldownSeconds": 900,
    "maxConsecutiveAutoTurns": 15,
    "maxAutomatedTurnsPerHour": 60
  }
}
