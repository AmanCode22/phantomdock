{
  "$schema": "phantomdock-adapter-v2",
  "id": "qwen-chat",
  "name": "Qwen Chat",
  "hostMatch": ["chat.qwen.ai"],
  "enabled": true,
  "selectors": {
    "chatContainer": "main, .chat-messages-container, body",
    "messageList": ".chat-messages, .chat-messages-container",
    "userMessage": ".qwen-chat-message-user, .chat-user-message, .user-message-content",
    "assistantMessage": ".qwen-chat-message-assistant, .chat-assistant-message, [data-role='assistant']",
    "messageMarkdownBody": ".qwen-markdown, .custom-qwen-markdown, .qwen-markdown-paragraph, .markdown-body",
    "streamingIndicator": "[class*='stop-button'], button[aria-label*='Stop'], [aria-label*='Stop generating'], [class*='generating'], button.send-button.stop",
    "inputBox": "textarea.message-input-textarea, textarea, [contenteditable='true']",
    "sendButton": "button.send-button, .chat-prompt-send-button button, .chat-prompt-send-button[role='button'], button[type='submit'], button[aria-label*='Send']",
    "pillMountAnchor": ".message-input-container, .chat-message-input-fixed, .message-input-wrapper",
    "rateLimitBanner": "[class*='rate-limit'], [class*='quota-exceeded']",
    "challengeBanner": "iframe[src*='turnstile'], iframe[src*='arkoselabs'], iframe[src*='hcaptcha'], [class*='captcha']"
  },
  "fileUpload": {
    "supported": true,
    "preferInlineOverUpload": false,
    "cascadeOrder": ["input", "paste", "drop"],
    "fileInputSelector": "input[type='file']",
    "dropZoneSelector": ".message-input-container, .chat-message-input-fixed",
    "attachmentChipSelector": "[class*='file-card'], [class*='attachment'], [class*='upload-item']",
    "uploadingSpinnerSelector": "[class*='uploading'], [class*='loading'], [role='progressbar']",
    "uploadTimeoutMs": 10000,
    "fallbackToInlineOnFailure": true
  },
  "inlineSkills": {
    "chunkSizeChars": 6000,
    "autoSendAllParts": false
  },
  "inputBehavior": {
    "inputType": "textarea",
    "submitMethod": "click",
    "submitDelayRangeMs": [400, 1400],
    "interTurnDelayRangeMs": [3000, 8000],
    "sendEnableTimeoutMs": 2500,
    "randomizeClickCoords": true,
    "clearBeforeInsert": true
  },
  "loopProtection": {
    "requireVisibleTab": true,
    "cooldownSeconds": 60,
    "backoffMultiplier": 2,
    "maxCooldownSeconds": 900,
    "maxConsecutiveAutoTurns": 15,
    "maxAutomatedTurnsPerHour": 60
  }
}
