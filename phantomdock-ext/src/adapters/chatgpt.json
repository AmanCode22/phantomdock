{
  "$schema": "phantomdock-adapter-v2",
  "id": "chatgpt",
  "name": "ChatGPT",
  "hostMatch": [
    "chatgpt.com",
    "chat.openai.com"
  ],
  "enabled": true,
  "selectors": {
    "chatContainer": "main, [class*='react-scroll-to-bottom']",
    "messageList": "[class*='react-scroll-to-bottom'], main",
    "userMessage": "[data-message-author-role='user'], div[data-talvt-turn-state]:has([data-conversation-role='user']), [class*='group/user-message']",
    "assistantMessage": "[data-message-author-role='assistant'], div[data-talvt-turn-state]:has([data-conversation-role='assistant'])",
    "messageMarkdownBody": ".markdown, [class*='markdown']",
    "streamingIndicator": "div[data-talvt-turn-state]:not([data-talvt-turn-state='complete']), button[aria-label*='Stop'], [data-testid='stop-button']",
    "inputBox": "#prompt-textarea, div.ProseMirror[contenteditable='true'], textarea, [contenteditable='true']",
    "sendButton": "button[data-testid='send-button'], button[aria-label*='Send']",
    "pillMountAnchor": "form, [class*='input-container']",
    "rateLimitBanner": "[class*='rate-limit'], [class*='usage-limit'], [class*='error-toast']",
    "challengeBanner": "iframe[src*='turnstile'], iframe[src*='arkoselabs'], iframe[src*='hcaptcha'], [class*='captcha']"
  },
  "fileUpload": {
    "supported": true,
    "preferInlineOverUpload": false,
    "cascadeOrder": [
      "input",
      "paste",
      "drop"
    ],
    "fileInputSelector": "input[type='file']",
    "dropZoneSelector": "form, [class*='input-container'], [class*='chat-input']",
    "attachmentChipSelector": "[class*='file-card'], [class*='attachment'], [class*='upload-item']",
    "uploadingSpinnerSelector": "[class*='uploading'], [class*='loading'], [role='progressbar']",
    "uploadTimeoutMs": 10000,
    "fallbackToInlineOnFailure": true
  },
  "inlineSkills": {
    "chunkSizeChars": 6000,
    "autoSendAllParts": false
  },
  "inputBehavior": {
    "inputType": "auto",
    "submitMethod": "click",
    "submitDelayRangeMs": [
      400,
      1400
    ],
    "interTurnDelayRangeMs": [
      3000,
      8000
    ],
    "sendEnableTimeoutMs": 2500,
    "randomizeClickCoords": true,
    "clearBeforeInsert": true
  },
  "loopProtection": {
    "requireVisibleTab": true,
    "cooldownSeconds": 60,
    "backoffMultiplier": 2,
    "maxCooldownSeconds": 900,
    "maxConsecutiveAutoTurns": 15,
    "maxAutomatedTurnsPerHour": 60
  }
}
